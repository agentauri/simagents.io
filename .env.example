# Optional browser-engine tuning for local scripts and test runs.
# The Vite app stores provider keys, roster, proxy URL, snapshots, replay frames,
# prompt logs, and experiment runs in browser localStorage.

TICK_INTERVAL_MS=60000
MAX_TICKS=0
GRID_SIZE=100
RANDOM_SEED=

# Set true to force fallback decisions in engine contexts that read process env.
TEST_MODE=false

# Optional local tuning.
ENGINE_DECISION_TIMEOUT_MS=60000
ENGINE_MIN_DECISION_INTERVAL_MS=1000
ENGINE_HEARTBEAT_INTERVAL_MS=1000
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300
