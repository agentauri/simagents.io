{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "types": ["vite/client", "bun-types"],
    "baseUrl": ".",
    "paths": {
      "@server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*", "../server/src/engine/**/*", "../server/src/engine-memory/**/*"]
}
